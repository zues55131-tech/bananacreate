name: Gerar mod Banana Create

on:
  push:
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 21

      - name: Extrair projeto
        run: |
          unzip bananacreate.zip
          cd bananacreate
          chmod +x gradlew

      - name: Compilar mod
        run: |
          cd bananacreate
          ./gradlew build

      - name: Disponibilizar JAR
        uses: actions/upload-artifact@v4
        with:
          name: BananaCreate-Mod
          path: bananacreate/build/libs/*.jar
